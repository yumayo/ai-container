# AI Container 設定サンプル
# ========================
# 新規作成時は、このファイルをワークスペース直下の .aicontainer にコピーし、
# 必要な設定行の先頭の「# 」を外して値を変更してください。
# example.aicontainer 自体は自動で読み込まれません。
# 全設定をコメントにしてあるため、そのままコピーすると既定値で動作します。
# 設定変更は、AIコンテナを終了して起動し直すと反映されます。
#
# 書式:
#   1行に key=value を1つ記述します。セクション名（[global] 等）は使いません。
#   説明のコメントは独立した行に書き、設定行の末尾には付けないでください。
#   複数行指定できる項目以外は、同じキーを複数回書くと最後の値を使います。
#   パスの例は、aicontainer を実行するワークスペースを基準としています。
#   追加マウントは .aimount、AIから隠すファイルは .aiignore で設定します。
#
# 詳しい起動手順・設定例は README.md を参照してください。


# -----------------------------------------------------------------------------
# AIツール・イメージ・セッション
# -----------------------------------------------------------------------------

# tool
# 既定: claude
# 値: claude / codex
# 引数なしで起動するAIツール。aicontainer codex 等の明示指定を優先します。
# aicontainer bash でも、この設定に応じた認証情報と通信許可を使います。
# tool=claude
# tool=codex

# codex_mode
# 既定: minimal
# 値: minimal / restricted（どちらか1つを指定）
# minimal:
#   ローカル実行等に必要な次のfeatureだけを有効にし、その他は無効にします。
#   shell_tool, unified_exec, unified_exec_tty, view_image, hooks,
#   code_mode_host, fast_mode, sleep_tool
#   CLIの features list から機能名を取得し、将来追加された機能も無効にします。
#   廃止済み・非推奨のフラグは指定対象から除きます。
#   一覧の取得・解析に失敗した場合は起動を中止します。
# restricted:
#   標準Web検索・ページ取得と、内蔵MCPの apps・worktrees だけを無効にします。
#   その他のfeatureはCLIの既定値・ユーザー設定を維持します。
#   許可リスト導入前と同じ制限で、起動前の features list は実行しません。
# 両モードとも web_search=disabled。認証情報・履歴・ユーザー設定は共有します。
# bash内でのCodex直接起動、codex exec / resume、WSL起動にも適用されます。
# codex_mode=minimal
# codex_mode=restricted

# image
# 既定: yumayo-ai
# 起動するDockerイメージ。事前にホスト側でビルドしておきます。
# image=yumayo-ai
# image=yumayo-ai-custom

# session
# 既定: 未指定（ワークスペース内の .claude.local / .codex.local に保存）
# 認証情報・履歴・AIツールの設定を置く共通ディレクトリ。
# 指定先にも .claude.local / .codex.local を作り、ツールごとに保存します。
# 相対パス・絶対パスに対応。複数プロジェクトで共有する場合に指定します。
# session=../.ai-session


# -----------------------------------------------------------------------------
# 追加ネットワーク・通信先
# -----------------------------------------------------------------------------
# localhost（127.0.0.1 / ::1）と、選択したAIツールのAPI・認証先は自動で許可します。
# その他の通信先を allow-dns / allow-ip で追加します。
# 許可先のIPや設定を変更した場合も、AIコンテナを起動し直してください。

# append-network
# 既定: 追加なし（外部通信用の専用ネットワークには常に参加）
# 複数行: 可（1行に1ネットワーク。重複と空の指定は無視）
# 他のコンテナと共有するDockerネットワーク名。
# 存在しなければbridgeネットワークを作成し、AIコンテナ終了後も残します。
# bridge / host / none は指定できません。
# Docker CLI / Engine 28.0以降、API 1.48以降が必要です。
# この指定だけでは通信を許可しません。接続先も allow-dns / allow-ip で指定します。
# append-network=myproject
# append-network=shared-tools

# allow-dns
# 既定: 追加なし
# 複数行: 可（1行に1つの名前）
# 接続を許可するコンテナ名・ネットワークエイリアス・外部ドメイン名。
# URLやポート番号ではなく名前だけを指定します。
# コンテナ名を使う場合は、append-network に同じDockerネットワークを指定します。
# 起動時にIPv4アドレスを解決し、/etc/hosts とIP許可リストに登録します。
# 接続先は先に起動してください。名前解決に失敗するとAIコンテナの起動を中止します。
# allow-dns=mcp-server
# allow-dns=api.example.org

# allow-ip
# 既定: 追加なし
# 複数行: 可（1行に1つのIPv4アドレスまたはCIDR）
# allow-dns と併用できます。IPv6アドレスやホスト名は指定できません。
# CIDRのプレフィックス長は0〜32。ホスト部は無視します。
# 名前解決やネットワークへの参加・経路は追加しません。
# allow-ip=192.168.1.10
# allow-ip=172.20.0.0/24

# allow-dns / allow-ip の許可は、DNS（UDP/TCP 53番）を除く全ポートが対象です。
# localhostは53番を含む全ポートを許可します。
# Docker内蔵DNS、コンテナ自身の非ループバックIP、localhost以外のIPv6は拒否します。
#
# HTTPのMCPサーバーに接続する例:
#   append-network=myproject と allow-dns=mcp-server を有効にします。
#   AIツールへのMCP登録は別途必要です。URL例: http://mcp-server:3000/mcp
#   サーバーは同じネットワーク上で 0.0.0.0 に待ち受けさせてください。


# -----------------------------------------------------------------------------
# コンテナ内のPATH・環境変数
# -----------------------------------------------------------------------------

# path
# 既定: 追加なし
# 複数行: 可（1行に1ディレクトリ）
# コンテナ内のPATHの先頭に、記載順で追加します。相対パス・絶対パスに対応。
# コンテナから参照できるディレクトリを指定してください。
# ワークスペース外のディレクトリは、必要に応じて .aimount でマウントします。
# path=./bin
# path=./tools/bin

# env
# 既定: 追加なし（AIツール等に必要な環境変数は自動で設定）
# 複数行: 可（1行に1環境変数）
# 値は NAME=VALUE の形式で指定し、NAME だけならホスト側の値を引き継ぎます。
# ワークスペースの .env にある値も、起動時にホスト側で読み込まれます。
# env=CLAUDE_CODE_EFFORT_LEVEL=max
# env=EXAMPLE_TOKEN


# -----------------------------------------------------------------------------
# ホスト側の起動前処理
# -----------------------------------------------------------------------------

# before-start-up
# 既定: 実行しない
# AIコンテナの起動前に、ホスト側のワークスペースで実行するシェルコマンド。
# 失敗するとAIコンテナを起動しません。aicontainer dump では実行しません。
# before-start-up=./setup.sh


# -----------------------------------------------------------------------------
# Docker Socket Proxy: 外部コンテナでコマンドを実行する
# -----------------------------------------------------------------------------
# 以下の3項目を設定し、実行先のコンテナをホスト側で先に起動してください。
# AIコンテナ内からは dp COMMAND [ARG ...] で実行します。
# 例: dp npx playwright test / dp pytest tests/
# 実行先の指定: dp -p workdir-dotnet-1 dotnet --version（--proxy-container-name も使用可）
# 作業ディレクトリの指定: dp -p workdir-dotnet-1 -c /app dotnet test（--cwd も使用可）
# 許可ルールには dp を付けません。
# プロキシはUnixソケットを使うため、append-network / allow-dns の指定は不要です。
# 既定では作業ディレクトリを引き継ぐため、実行先にも同じ絶対パスでプロジェクトをマウントします。
# 実行先のパスが異なる場合は -c で指定してください。

# docker-proxy-name
# 既定: 無効
# プロジェクトごとのプロキシ名。
# プロキシコンテナ名は yumayo-ai-proxy-<指定名> になります。
# 同じプロキシ名を使うプロジェクトは、許可設定もそろえてください。
# docker-proxy-name=myproject

# docker-proxy-allow
# 既定: 全コマンドを拒否
# 複数行: 可（1行に1ルール。カンマ区切りにはしません）
# コマンド列の先頭から照合し、一致した後の追加引数を許可します。
# python なら python script.py 等、npx playwright なら npx playwright test 等を許可。
# * は引数の境界を越えず0文字以上に一致します。? や [] は使えません。
# 例: npx playwright* は npx playwright / npx playwright@latest 等に一致します。
# docker-proxy-allow=python
# docker-proxy-allow=pytest
# docker-proxy-allow=npx playwright*

# docker-proxy-containers
# 既定: 全コンテナでのコマンド実行を拒否
# 複数行: 可（1行に1つの実際のコンテナ名。カンマ区切りにはしません）
# Composeのサービス名やコンテナIDではなく、docker ps に表示される名前を指定します。
# dp は記載順に試し、実行ファイルがPATHにない場合だけ次のコンテナへ進みます。
# 実行開始後の失敗は、別コンテナでは再実行しません。
# -p（--proxy-container-name）に登録済みの名前を指定すると、そのコンテナだけで実行します。
# docker-proxy-containers=myapp
# docker-proxy-containers=mytools


# -----------------------------------------------------------------------------
# 旧設定からの移行
# -----------------------------------------------------------------------------
# network は append-network、dns は allow-dns に変更されました。
# 旧名が残っていると起動時にエラーになります。
# 廃止済み: tool=claude-ollama / aicontainer ollama。
# .aibin の自動検出・コマンドが見つからない場合の自動転送も廃止しました。
# 外部コンテナで実行するコマンドには、明示的に dp を付けてください。
