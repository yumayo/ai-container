#!/bin/bash

# カラー定義
__AICONTAINER_RED='\033[0;31m'
__AICONTAINER_GREEN='\033[0;32m'
__AICONTAINER_YELLOW='\033[1;33m'
__AICONTAINER_BLUE='\033[0;34m'
__AICONTAINER_MAGENTA='\033[0;35m'
__AICONTAINER_CYAN='\033[0;36m'
__AICONTAINER_BOLD='\033[1m'
__AICONTAINER_NC='\033[0m'

__aicontainer_now() {
  date '+%H:%M:%S'
}

__aicontainer_now_ms() {
  date +%s%3N
}

__aicontainer_format_elapsed() {
  local start_ms="$1"
  local end_ms
  end_ms="$(__aicontainer_now_ms)"

  local elapsed_ms=$((end_ms - start_ms))
  printf '%d.%03ds' $((elapsed_ms / 1000)) $((elapsed_ms % 1000))
}

__aicontainer_log_step() {
  echo -e "${__AICONTAINER_BLUE}${__AICONTAINER_BOLD}[$(__aicontainer_now)] ▶ $1${__AICONTAINER_NC}"
}

__aicontainer_log_success() {
  echo -e "${__AICONTAINER_GREEN}[$(__aicontainer_now)] ✓ $1${__AICONTAINER_NC}"
}

__aicontainer_log_info() {
  echo -e "${__AICONTAINER_MAGENTA}[$(__aicontainer_now)] ℹ $1${__AICONTAINER_NC}"
}

__aicontainer_log_warning() {
  echo -e "${__AICONTAINER_YELLOW}[$(__aicontainer_now)] ⚠ $1${__AICONTAINER_NC}"
}

__aicontainer_log_error() {
  echo -e "${__AICONTAINER_RED}[$(__aicontainer_now)] ✗ $1${__AICONTAINER_NC}" >&2
}

# 1つのエントリーをAI_IGNOREに追加
__aicontainer_add_ignore_entry() {
  local host_path="$1"
  local container_path="$2"
  local message="$3"

  # 重複チェック
  if [ -n "${AI_IGNORE_PATHS[$container_path]}" ]; then
    __aicontainer_log_info "ignored (already): $message"
    return
  fi

  if [ -d "$host_path" ]; then
    AI_IGNORE="$AI_IGNORE \\
    --mount type=tmpfs,target=$container_path,tmpfs-size=0"
    AI_IGNORE_PATHS[$container_path]=1
    __aicontainer_log_info "ignored: $message"
  elif [ -f "$host_path" ]; then
    AI_IGNORE="$AI_IGNORE \\
    --mount type=bind,source=/dev/null,target=$container_path,readonly"
    AI_IGNORE_PATHS[$container_path]=1
    __aicontainer_log_info "ignored: $message"
  fi
}

# .aiignoreファイルを処理（base_dirとmount_dstを指定）
__aicontainer_process_aiignore_file() {
  local aiignore_file="$1"
  local base_dir="$2"
  local mount_dst="$3"

  __aicontainer_log_info "found .aiignore: $aiignore_file"

  local aiignore_dir="$(dirname "$aiignore_file")"

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"

    # 空行とコメント行をスキップ
    if [ -z "$line" ]; then
      continue
    fi
    if [[ "$line" =~ ^[[:space:]]*# ]]; then
      continue
    fi

    # パスの正規化
    line="${line#/}"
    local host_full_path="$aiignore_dir/$line"

    # マウント先でのパスを計算
    local rel_path="${host_full_path#$base_dir}"
    rel_path="${rel_path#/}"
    local container_path="$mount_dst/$rel_path"

    __aicontainer_add_ignore_entry "$host_full_path" "$container_path" "$container_path"
  done < "$aiignore_file"
}

# ディレクトリ直下の.aiignoreを処理
__aicontainer_process_aiignore_in_dir() {
  local src_dir="$1"
  local mount_dst="$2"
  local aiignore_file="$src_dir/.aiignore"

  if [ -f "$aiignore_file" ]; then
    __aicontainer_process_aiignore_file "$aiignore_file" "$src_dir" "$mount_dst"
  fi
}

# .aicontainer の hook を実行
__aicontainer_run_hook() {
  local hook_name="$1"
  local hook_cmd="${AICONTAINER_CONFIG[$hook_name]:-}"
  local started_at

  if [ -z "$hook_cmd" ]; then
    return 0
  fi

  started_at="$(__aicontainer_now_ms)"
  __aicontainer_log_step "hook($hook_name): $hook_cmd"
  if ! eval "$hook_cmd"; then
    __aicontainer_log_error "hook '$hook_name' failed"
    return 1
  fi
  __aicontainer_log_success "hook($hook_name): completed in $(__aicontainer_format_elapsed "$started_at")"
}

# .aicontainer を解析してAICONTAINER_CONFIG連想配列に設定
__aicontainer_parse_config() {
  local config_file=".aicontainer"

  if [ -d "$config_file" ]; then
    echo "Error: .aicontainer must be a file. Move settings out of the directory and into .aicontainer" >&2
    return 1
  fi

  if [ ! -f "$config_file" ]; then
    return
  fi

  __aicontainer_log_info "found .aicontainer: loading configuration..."

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    [ -z "$line" ] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue

    if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_-]*)[[:space:]]*=[[:space:]]*(.*)[[:space:]]*$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local value="${BASH_REMATCH[2]}"
      if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi
      # path, envキーは複数指定可能なため配列に蓄積
      if [ "$key" = "path" ]; then
        AICONTAINER_PATHS+=("$value")
        __aicontainer_log_info "config: $key=$value"
      elif [ "$key" = "env" ]; then
        AICONTAINER_ENVS+=("$value")
        __aicontainer_log_info "config: $key=$value"
      else
        AICONTAINER_CONFIG["$key"]="$value"
        __aicontainer_log_info "config: $key=$value"
      fi
    fi
  done < "$config_file"
}

__aicontainer_prepare_aibin_mounts() {
  local aibin_dir="$1"
  local started_at

  if [ ! -d "$aibin_dir" ]; then
    return
  fi

  started_at="$(__aicontainer_now_ms)"
  __aicontainer_log_step "aibin scan start: $aibin_dir"

  local file
  for file in "$aibin_dir"/*; do
    [ -e "$file" ] || continue

    if [ ! -f "$file" ]; then
      __aicontainer_log_warning "aibin skipped (not a file): $file"
      continue
    fi

    if [ ! -x "$file" ]; then
      __aicontainer_log_warning "aibin skipped (not executable): $file"
      continue
    fi

    AI_MOUNT="$AI_MOUNT \\
    --mount type=bind,source=$file,target=/usr/local/bin/$(basename "$file"),readonly"
    __aicontainer_log_info "aibin mounted: $(basename "$file") -> /usr/local/bin/$(basename "$file")"
  done

  __aicontainer_log_success "aibin scan done:  $aibin_dir ($( __aicontainer_format_elapsed "$started_at"))"
}

# Dockerネットワークが存在しない場合は作成する
__aicontainer_ensure_network() {
  local net_name="$1"
  if ! docker network inspect "$net_name" &>/dev/null; then
    __aicontainer_log_step "creating docker network: $net_name"
    docker network create "$net_name" &>/dev/null || { __aicontainer_log_error "failed to create network '$net_name'"; return 1; }
    __aicontainer_log_success "docker network ready: $net_name"
  fi
}

__aicontainer_start_proxy() {
  local proxy_allow="${1:-}"
  local proxy_name="yumayo-ai-proxy-${2}"
  local proxy_volume="yumayo-ai-proxy-${2}-sock"
  local proxy_containers="${3:-}"

  # 既に起動中の場合、設定が変わっていれば再起動
  if docker ps -q -f name="^${proxy_name}$" | grep -q .; then
    local current_allow current_containers
    current_allow="$(docker exec "$proxy_name" cat /etc/docker-proxy/allow.txt 2>/dev/null || true)"
    current_containers="$(docker exec "$proxy_name" cat /etc/docker-proxy/containers.txt 2>/dev/null || true)"
    if [ "$current_allow" = "$proxy_allow" ] && [ "$current_containers" = "$proxy_containers" ]; then
      __aicontainer_log_info "docker-proxy($2): already running"
      return 0
    fi
    __aicontainer_log_warning "docker-proxy($2): config changed, restarting..."
    docker stop "$proxy_name" &>/dev/null || true
    docker rm "$proxy_name" &>/dev/null || true
  fi

  __aicontainer_log_step "docker-proxy($2): starting..."
  docker rm "$proxy_name" 2>/dev/null || true
  docker volume create "$proxy_volume" &>/dev/null || true
  docker run -d \
    --name "$proxy_name" \
    -e DOCKER_PROXY_ALLOW="$proxy_allow" \
    -e DOCKER_PROXY_CONTAINERS="$proxy_containers" \
    -v /var/run/docker.sock:/var/run/docker.sock:ro \
    -v "$proxy_volume":/var/run/docker-proxy \
    yumayo-ai-proxy

  # ソケット準備待ち
  local retries=0
  while ! docker exec "$proxy_name" test -S /var/run/docker-proxy/docker.sock 2>/dev/null; do
    sleep 0.2
    retries=$((retries + 1))
    if [ $retries -ge 25 ]; then
      __aicontainer_log_error "docker-proxy socket not ready"
      return 1
    fi
  done
  __aicontainer_log_success "docker-proxy($2): ready"
}

__aicontainer_prepare_mount() {
  local src="$1"
  local dst="$2"
  local started_at

  started_at="$(__aicontainer_now_ms)"
  __aicontainer_log_step "mount start: $src -> $dst"

  AI_MOUNT="$AI_MOUNT \\
    --mount type=bind,source=$src,target=$dst"

  if [ -d "$src" ]; then
    __aicontainer_process_aiignore_in_dir "$src" "$dst"
  fi

  __aicontainer_log_success "mount done:  $src -> $dst ($( __aicontainer_format_elapsed "$started_at"))"
}

aicontainer() {
  # .aicontainer の設定を読み込み
  declare -A AICONTAINER_CONFIG
  AICONTAINER_PATHS=()
  AICONTAINER_ENVS=()
  __aicontainer_parse_config || return 1
  local config_network="${AICONTAINER_CONFIG[network]:-}"
  local config_session="${AICONTAINER_CONFIG[session]:-}"
  local config_docker_proxy_name="${AICONTAINER_CONFIG[docker-proxy-name]:-}"
  local config_docker_proxy_allow="${AICONTAINER_CONFIG[docker-proxy-allow]:-}"
  local config_docker_proxy_containers="${AICONTAINER_CONFIG[docker-proxy-containers]:-}"
  local config_image="${AICONTAINER_CONFIG[image]:-yumayo-ai}"
  local config_model="${AICONTAINER_CONFIG[model]:-}"

  # ツールモードを決定（明示引数 > .aicontainer > デフォルト）
  # 既知のツール名で始まらない場合は、引数をコンテナ内コマンドとして扱う。
  local AI_TOOL=""
  local AI_TOOL_MODEL=""
  local cmd_override=""
  local dump_mode=false
  case "${1:-}" in
    "" )
      ;;
    claude)
      AI_TOOL="claude"
      shift
      ;;
    codex)
      AI_TOOL="codex"
      shift
      ;;
    ollama)
      AI_TOOL="ollama"
      AI_TOOL_MODEL="${2:-}"
      shift
      [ $# -gt 0 ] && shift
      ;;
    dump)
      dump_mode=true
      shift
      case "${1:-}" in
        "" )
          ;;
        claude)
          AI_TOOL="claude"
          cmd_override="claude --dangerously-skip-permissions --disallowedTools WebSearch,WebFetch"
          shift
          ;;
        codex)
          AI_TOOL="codex"
          cmd_override="codex --yolo"
          shift
          ;;
        ollama)
          AI_TOOL="ollama"
          if [ -z "${2:-}" ]; then
            echo "Error: model name required. Usage: aicontainer dump ollama <model>" >&2
            return 1
          fi
          AI_TOOL_MODEL="${2}"
          config_model="${2}"
          cmd_override="claude --dangerously-skip-permissions --disallowedTools WebSearch,WebFetch --model ${2}"
          shift
          shift
          ;;
        *)
          cmd_override="$*"
          ;;
      esac
      ;;
    *)
      cmd_override="$*"
      ;;
  esac

  if [ -z "$AI_TOOL" ] && [ -n "${AICONTAINER_CONFIG[tool]:-}" ]; then
    case "${AICONTAINER_CONFIG[tool]}" in
      claude)
        AI_TOOL="claude"
        ;;
      codex)
        AI_TOOL="codex"
        ;;
      claude-ollama)
        if [ -z "$config_model" ]; then
          echo "Error: tool=claude-ollama requires 'model' setting in .aicontainer" >&2
          return 1
        fi
        AI_TOOL="ollama"
        AI_TOOL_MODEL="$config_model"
        ;;
      *)
        echo "Error: unknown tool '${AICONTAINER_CONFIG[tool]}' in .aicontainer (expected: claude, codex, claude-ollama)" >&2
        return 1
        ;;
    esac
  fi

  # モードに応じてディレクトリを決定
  local ai_dir=".claude.local"
  if [ "$AI_TOOL" = "ollama" ]; then
    ai_dir=".claude.ollama"
  elif [ "$AI_TOOL" = "codex" ]; then
    ai_dir=".codex.local"
  fi

  # セッションパスの解決（session指定時）
  local session_path=""
  if [ -n "$config_session" ]; then
    if [[ "$config_session" =~ ^/ ]]; then
      session_path="$config_session"
    else
      session_path="$(pwd)/$config_session"
    fi
    mkdir -p "$session_path"
    session_path="$(realpath "$session_path")"
    session_path="${session_path%/}"
    __aicontainer_log_info "session path: $session_path"
  fi

  # ディレクトリ構造を作成
  if [ -n "$config_session" ]; then
    # セッションモード: 指定パスにディレクトリ構造を作成
    mkdir -p "$session_path/$ai_dir"
    if [ "$AI_TOOL" != "codex" ]; then
      [ ! -f "$session_path/$ai_dir/.claude.json" ] && echo '{}' > "$session_path/$ai_dir/.claude.json" || true
      mkdir -p "$session_path/$ai_dir/.claude"
    fi
  else
    # ディレクトリモード: 従来のローカルディレクトリを作成
    mkdir -p "$ai_dir"
    if [ "$AI_TOOL" != "codex" ]; then
      [ ! -f "$ai_dir/.claude.json" ] && echo '{}' > "$ai_dir/.claude.json" || true
      mkdir -p "$ai_dir/.claude"
    fi
  fi

  # .envファイルを読み込んで環境変数として設定（docker-compose.ymlと同様の挙動）
  if [ -f .env ]; then
    __aicontainer_log_info "found .env: loading environment variables..."
    while IFS= read -r line || [ -n "$line" ]; do
      # CRを除去
      line="${line%$'\r'}"
      # 空行をスキップ
      [ -z "$line" ] && continue
      # コメント行をスキップ
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      # 空白のみの行をスキップ
      [[ "$line" =~ ^[[:space:]]*$ ]] && continue
      # KEY=VALUE形式かチェック
      if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*)[[:space:]]*$ ]]; then
        local key="${BASH_REMATCH[1]}"
        local value="${BASH_REMATCH[2]}"
        # 値のクォートを除去（シングル/ダブル）
        if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
          value="${BASH_REMATCH[1]}"
        fi
        export "$key=$value"
        __aicontainer_log_info "loaded: $key"
      fi
    done < .env
  fi

  AI_IGNORE=""
  declare -A AI_IGNORE_PATHS

  # ワークスペース直下の.aiignoreを処理
  local workspace_scan_started_at
  workspace_scan_started_at="$(__aicontainer_now_ms)"
  __aicontainer_log_step "workspace scan start: $(pwd)"
  __aicontainer_process_aiignore_in_dir "." "$(pwd)"
  __aicontainer_log_success "workspace scan done:  $(pwd) ($( __aicontainer_format_elapsed "$workspace_scan_started_at"))"

  AI_MOUNT=""

  # .aimountを処理
  if [ -f .aimount ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%$'\r'}"
      if [ -z "$line" ]; then
        continue
      fi
      if [[ "$line" =~ ^[[:space:]]*# ]]; then
        continue
      fi

      # 先に環境変数を展開してから:で分割
      local expanded_line
      if ! expanded_line="$(eval echo "$line" 2>&1)"; then
        echo "Error: environment variable error: $line" >&2
        echo "  $expanded_line" >&2
        return 1
      fi

      # 展開後の行を:で分割
      IFS=':' read -r src dst <<< "$expanded_line"
      if [ -z "$src" ] || [ -z "$dst" ]; then
        echo "Error: invalid format (expected 'src:dst'): $line" >&2
        return 1
      fi

      # 相対パスを絶対パスに変換し、パスを正規化
      [[ ! "$src" =~ ^/ ]] && src="$(pwd)/$src"

      if [ ! -e "$src" ]; then
        __aicontainer_log_error "mount source not found: $src"
        return 1
      fi

      src="$(realpath "$src")"
      __aicontainer_prepare_mount "$src" "$dst"
    done < .aimount
  fi

  # 引数チェック
  local cmd="claude --dangerously-skip-permissions --disallowedTools WebSearch,WebFetch"
  # プレフィックス付与: .aicontainer 指定時は yumayo-ai-<name>、未指定時は yumayo-ai
  local network="yumayo-ai"
  if [ -n "$config_network" ]; then
    network="yumayo-ai-$config_network"
  fi
  # 1Mコンテキストが使用できないことがあるらしいのでOFFにしてます。
  # https://github.com/anthropics/claude-code/issues/34143#issuecomment-4058474125
  # extra_env="-e DISABLE_TELEMETRY=1 -e CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
  local extra_env="-e DISABLE_AUTOUPDATER=true"
  local extra_opts="--cap-add=NET_ADMIN --cap-add=NET_RAW"
  local shell_prefix="bash"

  if [ "$dump_mode" = true ]; then
    if [ "$AI_TOOL" = "codex" ]; then
      extra_env="-e FIREWALL_MODE=codex"
      if [ -n "$OPENAI_API_KEY" ]; then
        extra_env="$extra_env -e OPENAI_API_KEY=$OPENAI_API_KEY"
      fi
    else
      extra_env="-e CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000 -e CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1"
    fi
  elif [ "$AI_TOOL" = "ollama" ]; then
    if [ -z "$AI_TOOL_MODEL" ]; then
      echo "Error: model name required. Usage: aicontainer ollama <model>" >&2
      return 1
    fi
    cmd="claude --dangerously-skip-permissions --disallowedTools WebSearch,WebFetch --model $AI_TOOL_MODEL"
    extra_env="-e ANTHROPIC_AUTH_TOKEN=ollama -e ANTHROPIC_BASE_URL=http://ollama:11434"
    # https://github.com/yumayo/nginx-open-webui-ollama
    # ネットワークを切り替えています。
    # 完全ローカルで動作させるため、ollamaコンテナで動作させます。
    network="nginx-open-webui-ollama_internal_net"
    extra_opts="--entrypoint bash"
    shell_prefix=""
  elif [ "$AI_TOOL" = "codex" ]; then
    # codex-cli (OpenAI Codex CLI)
    # 認証方法:
    #   1. ChatGPTアカウントでサインイン（Plus/Pro/Business/Enterprise契約者）
    #   2. OPENAI_API_KEYで認証（従量課金）
    # 初回起動時にcodex側でサインインを求められます
    cmd="codex --yolo"
    extra_env="-e FIREWALL_MODE=codex"
    if [ -n "$OPENAI_API_KEY" ]; then
      extra_env="$extra_env -e OPENAI_API_KEY=$OPENAI_API_KEY"
    fi
  else
    # claudeモード（デフォルト/明示指定）
    extra_env="-e CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000 -e CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1"
  fi

  if [ -n "$cmd_override" ]; then
    cmd="$cmd_override"
  fi

  # .aicontainer の env 設定を追加
  if [ ${#AICONTAINER_ENVS[@]} -gt 0 ]; then
    for env_entry in "${AICONTAINER_ENVS[@]}"; do
      extra_env="$extra_env -e $env_entry"
    done
  fi

  # ネットワークが存在しない場合は作成する（dumpモード時はスキップ）
  if [ "$dump_mode" != true ]; then
    __aicontainer_ensure_network "$network" || return 1
  fi

  # docker-proxyの起動（dumpモード時はスキップ）
  if [ -n "$config_docker_proxy_name" ] && [ "$dump_mode" != true ]; then
    __aicontainer_start_proxy "$config_docker_proxy_allow" "$config_docker_proxy_name" "$config_docker_proxy_containers" || return 1
  fi

  # dockerコマンドを構築
  local workdir="$(pwd)"
  local session_mounts=""
  local init_cmd=""

  # .aicontainer の path 設定をPATHに追加
  if [ ${#AICONTAINER_PATHS[@]} -gt 0 ]; then
    local extra_paths=""
    for p in "${AICONTAINER_PATHS[@]}"; do
      # 相対パスはworkdir基準で絶対パスに変換
      if [[ ! "$p" =~ ^/ ]]; then
        p="$workdir/$p"
      fi
      extra_paths="${extra_paths}${p}:"
    done
    # .bashrcに書き込み（後続のシェルでもPATHが有効）+ 現在のシェルにもexport
    init_cmd="echo 'export PATH=${extra_paths}\\\$PATH' >> ~/.bashrc && export PATH=${extra_paths}\\\$PATH && "
  fi

  __aicontainer_prepare_aibin_mounts "$workdir/.aibin"

  if [ -n "$config_session" ]; then
    # セッションモード: ホストの指定パスをバインドマウント
    if [ "$AI_TOOL" = "codex" ]; then
      session_mounts="--mount type=bind,source=\"$session_path/$ai_dir\",target=/home/ubuntu/.codex"
    else
      session_mounts="--mount type=bind,source=\"$session_path/$ai_dir/.claude\",target=/home/ubuntu/.claude \\
    --mount type=bind,source=\"$session_path/$ai_dir/.claude.json\",target=/home/ubuntu/.claude.json"
    fi
    # セッションパスがワークスペース配下の場合、tmpfsでAIから隠す
    # ~/.claudeはAIから常にアクセス可能だが、ワークスペース内にセッションディレクトリが
    # 存在するとlsやfind等でプロジェクトファイルと誤認される可能性がある。
    # tmpfsで上書きすることで、ワークスペースパス経由の重複アクセスを防ぐ。
    # ワークスペース外のパスはコンテナ内から見えないため対応不要。
    if [[ "$session_path/$ai_dir" == "$workdir"* ]]; then
      session_mounts="--mount type=tmpfs,target=$session_path/$ai_dir,tmpfs-size=0 \\
    $session_mounts"
    fi
  else
    # ディレクトリモード: 従来のローカルディレクトリを使用
    # ワークスペース直下にai_dirが存在するため、AIがプロジェクトファイルと
    # 誤認しないようtmpfsで隠す（実際のデータは~/.claude等に個別マウント済み）
    if [ "$AI_TOOL" = "codex" ]; then
      session_mounts="--mount type=tmpfs,target=$workdir/$ai_dir,tmpfs-size=0 \\
    --mount type=bind,source=\"$workdir/$ai_dir\",target=/home/ubuntu/.codex"
    else
      session_mounts="--mount type=tmpfs,target=$workdir/$ai_dir,tmpfs-size=0 \\
    --mount type=bind,source=\"$workdir/$ai_dir/.claude\",target=/home/ubuntu/.claude \\
    --mount type=bind,source=\"$workdir/$ai_dir/.claude.json\",target=/home/ubuntu/.claude.json"
    fi
  fi

  # docker-proxy有効時: プロキシソケットのマウントとDOCKER_HOSTを追加
  if [ -n "$config_docker_proxy_name" ]; then
    extra_opts="$extra_opts -v yumayo-ai-proxy-${config_docker_proxy_name}-sock:/var/run/docker-proxy"
    extra_env="$extra_env -e DOCKER_HOST=unix:///var/run/docker-proxy/docker.sock"
  fi

  local docker_cmd="docker run -ti --rm \\
    --stop-timeout 0 \\
    --network $network \\
    -w \"$workdir\" \\
    $extra_env \\
    $extra_opts \\
    --mount type=bind,source=\"$workdir\",target=\"$workdir\" \\
    $session_mounts$AI_MOUNT$AI_IGNORE \\
    $config_image \\
    $shell_prefix -ci \"${init_cmd}$cmd\""

  if [ "$dump_mode" = true ]; then
    echo "$docker_cmd"
  else
    # before-start-up hookを実行
    __aicontainer_run_hook "before-start-up" || return 1
    __aicontainer_log_step "container start: image=$config_image network=$network"
    __aicontainer_log_info "workspace mount: $workdir -> $workdir"
    eval "$docker_cmd"
  fi
}
